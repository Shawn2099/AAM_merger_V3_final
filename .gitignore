# cross-platform gitignore for AAM_MERGER-FINAL (linux dev → win2016 prod)
# SPEC §13: config.yaml is gitignored, config.example.yaml is committed
config.yaml
.env
*.env
!.env.example

# SPEC §13 + §6: runtime data (never commit)
# Windows prod C:\AAM\* , Linux dev ./data/* via pathlib+config.yaml
# Keep .gitkeep so empty folders exist on clone; ignore real data files
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/stored/*
!data/stored/.gitkeep
data/unclassified/*
!data/unclassified/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/samples/*
!data/samples/.gitkeep
data/Automation/
data/backup/
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-shm
*.db-wal
aam_merger.sqlite3

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.env*/
.conda/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# prefect / alembic noise
.prefect/
alembic/__pycache__/

# OS cross-platform
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# gitnexus local index (regenerated via `gitnexus analyze --skip-git`)
.gitnexus/
graphify-out/

# prek local
.prek/

# skills runtime (installed via `skills add`, not source)
.agents/
.claude/skills/

# keep these at repo root (commit)
!.mcp.json
!AGENTS.md
!skills-lock.json
.worktrees/
worktrees/
