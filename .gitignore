# cross-platform gitignore for AAM_MERGER-FINAL (linux dev → win2016 prod)
# SPEC §13: config.yaml is gitignored, config.example.yaml is committed
config.yaml
.env
*.env
!.env.example

# SPEC §13 + §6: runtime data (never commit)
# Windows prod C:\AAM\* , Linux dev ./data/* via pathlib+config.yaml
# Keep .gitkeep so empty folders exist on clone; ignore real data files
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/stored/*
!data/stored/.gitkeep
data/unclassified/*
!data/unclassified/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/samples/*
!data/samples/.gitkeep
data/real_samples/
data/Automation/
data/backup/
data/combined/
data/development/
data/ui_test_probe/
data/*.json
data/extraction_dump.json
data/raw_extractions/
data/raw_extractions/*
data/.sync.lock
data/*.lock
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-*
*.bak
*.db.bak
aam_merger.sqlite3
logs/
data/backup/
data/backup/*

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.env*/
.conda/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# prefect / alembic noise
.prefect/
alembic/__pycache__/

# OS cross-platform
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# gitnexus local index (regenerated via `gitnexus analyze --skip-git`)
.gitnexus/
graphify-out/

# prek local
.prek/

# skills runtime (installed via `skills add`, not source)
.agents/
.claude/skills/

# keep these at repo root (commit)
!.mcp.json
!AGENTS.md
!skills-lock.json
.worktrees/
worktrees/

# DB backups with a timestamp suffix (e.g. aam_merger.db.bak-20261022-201905, *.db-wal.bak-*)
*.db.bak*
*.db-wal.bak*
*.db-shm.bak*

# Local-only working data (real corpus backup, previous run, eval work): never commit
data/input_corpus_backup/
data/prev_run_20261024/
data/ui_test/
# Eval and pattern-lab work is tracked; the real documents (renders, PDFs) and databases are not
pattern_lab/**/*.png
pattern_lab/**/*.jpg
pattern_lab/**/*.jpeg
pattern_lab/**/*.pdf
pattern_lab/**/*.db
pattern_lab/**/*.sqlite*
prompt_improvement/**/*.png
prompt_improvement/**/*.jpg
prompt_improvement/**/*.jpeg
prompt_improvement/**/*.pdf
prompt_improvement/**/*.db
prompt_improvement/**/*.sqlite*
scratch_*
scratch_dump/

# Release harness output (baselines under tests/ui/release/__snapshots__ ARE tracked)
tests/ui/release/artifacts/
tests/ui/release/snapshot_failures/
reports/
.playwright-mcp/
