# Copy to .env and fill — never commit .env (gitignored)
# SPEC NFR-5: secrets via env/.env only
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: override config path
# AAM_CONFIG_PATH=./config.yaml
# Optional unattended install only (auth.bootstrap_from_env: true).
# Creates the first admin when the users table is empty; ignored afterwards.
# The account must change its password at first login. Remove these afterwards.
# AAM_BOOTSTRAP_ADMIN_USERNAME=admin
# AAM_BOOTSTRAP_ADMIN_PASSWORD=change-me-at-first-login
